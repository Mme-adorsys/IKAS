# IKAS Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# For a fresh setup: `./scripts/setup-fresh.sh` will prompt you for any missing
# required values and write them into .env automatically.

# =============================================================================
# REQUIRED — LLM API KEYS
# =============================================================================
# The demo is cost-locked to Claude Haiku 4.5 (cheapest model).
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL — Gemini API Key (alternative provider; not used while Haiku-lock is active)
GEMINI_API_KEY=

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# NEO4J CONFIGURATION
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# AI GATEWAY CONFIGURATION
# =============================================================================
AI_GATEWAY_PORT=8005
LLM_PROVIDER=anthropic
# Cost-lock: only this model can run. Set IKAS_MODEL_ALLOWLIST=* to disable the lock.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MODEL=claude-haiku-4-5-20251001
IKAS_MODEL_ALLOWLIST=claude-haiku-4-5-20251001

# Demo bootstrap — keep these on for the conference demo
DEMO_SEED_ON_BOOT=true
DEMO_SIMULATOR=true
REALM_SYNC_INTERVAL_MS=60000

# MCP Server URLs (for HTTP mode)
KEYCLOAK_MCP_URL=http://localhost:8001
NEO4J_MCP_URL=http://localhost:8002

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8005
NEXT_PUBLIC_WS_URL=http://localhost:3001

# =============================================================================
# WEBSOCKET SERVER CONFIGURATION (Phase 2)
# =============================================================================
WS_PORT=3001

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# Voice Recognition Settings
VOICE_LANGUAGE=de-DE
VOICE_HOTWORD=Hey Keycloak

# Demo Mode (for Amsterdam presentation)
DEMO_MODE=false
CACHE_DEMO_RESPONSES=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# PostgreSQL (for Keycloak)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# =============================================================================
# MONITORING & OBSERVABILITY (Future)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686